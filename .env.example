# ---------------------------------------------------------------------------
# Isaiah Café — SMTP configuration for the contact & newsletter forms.
# Copy this file to `.env.local` (dev) or `.env` (production) and adjust.
# Defaults target a VPS-local mail relay (e.g. Postfix) on localhost:25.
# ---------------------------------------------------------------------------

# SMTP server host. LEAVE BLANK to run forms in "log-only" mode — submissions
# are accepted and written to the server log, but no email is sent. Set a host
# (e.g. localhost for a local relay, or an external SMTP server) to enable
# real delivery.
SMTP_HOST=

# SMTP port — 25 (relay), 587 (submission/STARTTLS), or 465 (implicit TLS)
SMTP_PORT=25

# Set to "true" only for port 465 (implicit TLS)
SMTP_SECURE=false

# Auth — leave blank for an unauthenticated local relay
SMTP_USER=
SMTP_PASS=

# Where form submissions are delivered
MAIL_TO=hello@isaiahcafe.com

# From header on outgoing mail (use a domain you control to pass SPF/DKIM)
MAIL_FROM="Isaiah Café <no-reply@isaiahcafe.com>"
